# Local Compose defaults. Copy to .env and replace secrets only when needed.
OPSPULSE_BIND_ADDRESS=127.0.0.1
OPSPULSE_HOST_PORT=8080
OPSPULSE_RELEASE=
LOG_LEVEL=INFO

# Required only for the optional monitoring profile.
MONITORING_BIND_ADDRESS=127.0.0.1
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password