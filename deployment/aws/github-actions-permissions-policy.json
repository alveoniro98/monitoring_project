{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SendCommandsOnlyToTaggedOpsPulseInstances",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ec2:ap-southeast-3:ACCOUNT_ID:instance/*",
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "opspulse"
        }
      }
    },
    {
      "Sid": "UseAWSRunShellScriptDocument",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": "arn:aws:ssm:ap-southeast-3::document/AWS-RunShellScript"
    },
    {
      "Sid": "ReadCommandInvocationStatus",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    }
  ]
}
